# ============================================================
# OpenRD 后端环境变量配置
# 复制本文件为 .env 并填入实际值
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------

# 运行环境：development（开发）/ production（生产）/ testing（测试）
APP_ENV=development

# API 服务监听端口
APP_PORT=8000

# ------------------------------------------------------------
# 数据库 (PostgreSQL)
# ------------------------------------------------------------

# 数据库连接字符串
# 格式：postgresql+asyncpg://用户名:密码@地址:端口/数据库名
# 示例：postgresql+asyncpg://openrd:mypassword@127.0.0.1:5432/openrd
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ------------------------------------------------------------
# Redis 缓存
# ------------------------------------------------------------

# Redis 连接地址，用于 Token 白名单/黑名单、验证码存储、频率限制
# 格式：redis://[:密码@]地址:端口/库号
# 无密码示例：redis://localhost:6379/0
# 有密码示例：redis://:mypassword@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# JWT 认证
# ------------------------------------------------------------

# JWT 签名密钥（必须修改为随机字符串，泄露会导致 Token 被伪造）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT 签名算法（一般无需修改）
JWT_ALGORITHM=HS256

# access_token 过期时间（分钟），默认 15 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=15

# refresh_token 过期时间（天），默认 7 天
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# 文件存储
# ------------------------------------------------------------

# 存储模式：local（本地磁盘）/ oss（阿里云 OSS）
STORAGE_BACKEND=local

# 本地存储目录（STORAGE_BACKEND=local 时生效）
UPLOAD_DIR=./uploads

# 单个文件最大大小（MB）
MAX_FILE_SIZE_MB=20

# ------------------------------------------------------------
# 阿里云 OSS 对象存储（STORAGE_BACKEND=oss 时生效）
# ------------------------------------------------------------

# AccessKey ID（在阿里云控制台 RAM 访问控制中创建）
OSS_ACCESS_KEY_ID=

# AccessKey Secret
OSS_ACCESS_KEY_SECRET=

# 存储桶名称
OSS_BUCKET_NAME=

# OSS 服务地域节点
# 各地域 endpoint 参考：https://help.aliyun.com/document_detail/31837.html
# 示例：oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=

# 文件访问域名前缀（用于拼接文件下载 URL）
# 示例：https://your-bucket.oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_URL=

# ------------------------------------------------------------
# 阿里云短信服务 (Dysms)
# ------------------------------------------------------------

# AccessKey ID（可与 OSS 共用同一对，也可单独创建）
SMS_ACCESS_KEY_ID=

# AccessKey Secret
SMS_ACCESS_KEY_SECRET=

# 短信签名名称（在阿里云短信控制台申请）
# 示例：OpenRD协作平台
SMS_SIGN_NAME=

# 短信模板 - 注册验证码（模板变量：${code}）
SMS_TEMPLATE_REGISTER=

# 短信模板 - 重置密码验证码（模板变量：${code}）
SMS_TEMPLATE_RESET_PASSWORD=

# 验证码有效期（分钟），默认 5 分钟
SMS_CODE_EXPIRE_MINUTES=5

# 验证码发送冷却时间（秒），同一手机号两次发送的最小间隔
SMS_CODE_COOLDOWN_SECONDS=60
