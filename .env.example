# Root reference only. Runtime variables belong in backend/.env and frontend/.env.local.

# Frontend development: requests use the real backend unless this is exactly true.
VITE_ENABLE_MOCK=false

# Backend reference values. See backend/.env.example for the complete list.
APP_ENV=development
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/openrd
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET_KEY=replace-with-a-random-secret
